# ========================================================
# MOVA — Environment Variables Configuration Template
# ========================================================
# Copy this file to `.env.local` for local development overrides:
# cp .env.example .env.local

# --------------------------------------------------------
# 1. APPLICATION & METADATA
# --------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="MOVA"
NEXT_PUBLIC_SITE_DESCRIPTION="Modern People Discovery & Portfolio Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# 2. DEMO SYSTEM TOGGLES
# --------------------------------------------------------
# Set to 'true' to enable 1-click role logins and mock localStorage state
NEXT_PUBLIC_DEMO_MODE=true

# --------------------------------------------------------
# 3. PRODUCTION BACKEND / DATABASE (Optional for future scale)
# --------------------------------------------------------
# When connecting a real PostgreSQL / Supabase / Prisma database:
# DATABASE_URL="postgresql://user:password@localhost:5432/mova_db"

# --------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Optional for production RBAC)
# --------------------------------------------------------
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="generate-a-secure-random-32-character-secret"

# --------------------------------------------------------
# 5. STORAGE & UPLOADS (Optional for Cloudinary / AWS S3)
# --------------------------------------------------------
# NEXT_PUBLIC_UPLOAD_PROVIDER="local" # 'local' | 'cloudinary' | 's3'
